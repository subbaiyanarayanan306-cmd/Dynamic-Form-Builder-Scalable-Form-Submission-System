{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Dynamic Form Builder & Submission API",
    "description": "Postman collection matching /api/forms routes in formRoutes.js and server.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "your-admin-jwt-token-here",
      "type": "string"
    },
    {
      "key": "formId",
      "value": "replace-with-form-id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Routes",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Published Forms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forms/published",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "published"
              ]
            }
          }
        },
        {
          "name": "Submit Form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {\n    \"firstName\": \"Aarav\",\n    \"email\": \"aarav@example.com\",\n    \"gender\": \"Male\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/{{formId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "{{formId}}",
                "submit"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Protected Routes",
      "item": [
        {
          "name": "Create Form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Registration\",\n  \"mail\": \"admin@example.com\",\n  \"gender\": \"Other\",\n  \"mobile\": \"9876543210\",\n  \"description\": \"Onboarding form for new customers\",\n  \"department\": \"Operations\",\n  \"designation\": \"Coordinator\",\n  \"role\": \"Admin\",\n  \"status\": \"DRAFT\",\n  \"fields\": [\n    {\n      \"key\": \"firstName\",\n      \"label\": \"First Name\",\n      \"type\": \"TEXT\",\n      \"required\": true\n    },\n    {\n      \"key\": \"email\",\n      \"label\": \"Email\",\n      \"type\": \"EMAIL\",\n      \"required\": true\n    },\n    {\n      \"key\": \"gender\",\n      \"label\": \"Gender\",\n      \"type\": \"SELECT\",\n      \"required\": true,\n      \"options\": [\n        \"Male\",\n        \"Female\",\n        \"Other\"\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms"
              ]
            }
          }
        },
        {
          "name": "Get All Forms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms"
              ]
            }
          }
        },
        {
          "name": "Get All Submissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forms/submissions?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "submissions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Form",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forms/{{formId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "{{formId}}"
              ]
            }
          }
        },
        {
          "name": "Update Form",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Customer Registration\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/{{formId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "{{formId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Form",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/forms/{{formId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "{{formId}}"
              ]
            }
          }
        },
        {
          "name": "Publish / Draft Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/{{formId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "{{formId}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}